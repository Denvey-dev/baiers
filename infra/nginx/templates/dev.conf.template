server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    #Api
    location ${API_STR} {
        proxy_pass http://backend_api;
        include /etc/nginx/snippets/general.conf;
        client_max_body_size 100M;
    }

    #Websocket
    location /ws/ {
        proxy_pass http://backend_api;
        include /etc/nginx/snippets/websocket.conf;
        include /etc/nginx/snippets/general.conf;
    }

    #Start front
    location / {
        proxy_pass http://front_info;
        include /etc/nginx/snippets/general.conf;
    }
}


#Admin panels
server {
    listen 80;
    server_name admin.${DOMAIN};

    location / {
        proxy_pass http://front_admin;
        include /etc/nginx/snippets/general.conf;
        try_files $uri /index.html;
    }
}

server {
    listen 80;
    server_name super.${DOMAIN};

    location / {
        proxy_pass http://front_super;
        include /etc/nginx/snippets/general.conf;
        try_files $uri /index.html;
    }
}


#Tools
server {
    listen 80;
    server_name ${S3_HOST_DOMAIN}.${DOMAIN};

    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://minio_s3;
        include /etc/nginx/snippets/general.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

server {
    listen 80;
    server_name ${S3_HOST_CONSOLE}.${DOMAIN};

    client_max_body_size 100M;

    location / {
        proxy_pass http://minio_console;
        include /etc/nginx/snippets/websocket.conf;
        include /etc/nginx/snippets/general.conf;
    }
}


